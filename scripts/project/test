#!/usr/bin/env bash
# Project test hook: offline unit checks for the combat teacher and each
# imported project. Dependency-bound checks are attempted and recorded as
# SKIPPED (not failed) when their runtime is unavailable.
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
export PYTHONDONTWRITEBYTECODE=1
cd "$root"
failed=0

run() { # run <label> <cmd...>
  local label="$1"; shift
  echo "== $label"
  if "$@"; then :; else echo "FAIL: $label" >&2; failed=1; fi
}

if command -v node >/dev/null 2>&1; then
  run "agent37 bridge tests" node --test bridge/*.test.js bridge/public/*.test.js
  for proj in primecraft-ce mindcraft-ce; do
    if [[ -f "projects/$proj/tools/prime-ce-bridge.mjs" ]]; then
      run "$proj bridge syntax" node --check "projects/$proj/tools/prime-ce-bridge.mjs"
      out="$(cd "projects/$proj" && node --test src/agent/advancements.test.mjs src/agent/prime_controller.test.mjs 2>&1)"
      if [[ $? -ne 0 ]]; then
        if grep -q 'ERR_MODULE_NOT_FOUND' <<<"$out"; then
          echo "SKIP: $proj prime tests need node_modules (not vendored)"
        else
          echo "$out" >&2; echo "FAIL: $proj prime tests" >&2; failed=1
        fi
      fi
    fi
  done
  if [[ -f projects/fast-brain/bridge.mjs ]]; then
    run "fast-brain bridge syntax" node --check projects/fast-brain/bridge.mjs
  fi
else
  echo "node unavailable; skipping Node checks"
fi

if [[ -d projects/primecraft-vision-loop/primecraft ]]; then
  run "vision-loop compileall" python -m compileall -q projects/primecraft-vision-loop/primecraft
  (cd projects/primecraft-vision-loop && run "vision-loop smoke" python smoke_check.py && run "vision-loop help" python -m primecraft --help >/dev/null)
fi
if [[ -d projects/fast-brain/tests ]]; then
  (cd projects/fast-brain && run "fast-brain unit tests" python -m unittest tests.test_situations tests.test_skills)
fi

if command -v uv >/dev/null 2>&1 && uv run --offline --no-sync python -c 'import pytest' >/dev/null 2>&1; then
  run "agent37 pytest" uv run --offline --no-sync pytest tests/
else
  echo "SKIP: agent37 pytest unavailable via uv"
fi

if [[ "$failed" -ne 0 ]]; then
  exit 1
fi
echo "project test: PASS"
