            "bridge.mjs",
            "public/"
          ]
        },
        {
          "id": "system2",
          "files": [
            "harness/",
            "tests/"
          ]
        },
        {
          "id": "rocket2-optional",
          "files": [
            "runner.py",
            "vendor/ (excluded, hash-recorded)",
