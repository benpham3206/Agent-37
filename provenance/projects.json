{
  "version": 1,
  "projects": [
    {
      "id": "primecraft-ce",
      "name": "PrimeCraft CE",
      "kind": "project",
      "destination": "projects/primecraft-ce",
      "source_ids": [
        "primecraft-ce-src"
      ],
      "import_mode": "git-archive-snapshot+working-tree-overlay",
      "diff_labels": [
        "mindcraft-ce-base",
        "primecraft-agent-contract"
      ],
      "manifest": "primecraft-ce-dest.sha256",
      "exclusions": [
        "node_modules",
        "__pycache__",
        ".venv",
        "keys.json",
        "auth caches",
        "logs",
        "worlds"
      ],
      "license_files": [
        "LICENSE"
      ],
      "relationships": [
        "shares byte-identical Prime-contract files with mindcraft-ce (provenance/comparisons/ce-shared-prime-files.md)"
      ],
      "checks": [
        {
          "name": "bridge syntax",
          "command": "node --check tools/prime-ce-bridge.mjs",
          "offline": true
        },
        {
          "name": "prime unit tests",
          "command": "node --test src/agent/advancements.test.mjs src/agent/prime_controller.test.mjs",
          "offline": true
        }
      ],
      "subsystems": []
    },
    {
      "id": "mindcraft-ce",
      "name": "Mindcraft CE (active)",
      "kind": "project",
      "destination": "projects/mindcraft-ce",
      "source_ids": [
        "mindcraft-ce-src"
      ],
      "import_mode": "git-archive-snapshot+working-tree-overlay",
      "diff_labels": [
        "mindcraft-ce-base",
        "primecraft-agent-contract",
        "mindcraft-ce-runtime-upgrade"
      ],
      "manifest": "mindcraft-ce-dest.sha256",
      "exclusions": [
        "node_modules",
        "__pycache__",
        ".venv",
        "keys.json",
        "auth caches",
        "logs",
        "worlds"
      ],
      "license_files": [
        "LICENSE"
      ],
      "relationships": [
        "byte-identical Prime-contract files with primecraft-ce",
        "same stable base as mindcraft-ce-legacy comparison"
      ],
      "checks": [
        {
          "name": "bridge syntax",
          "command": "node --check tools/prime-ce-bridge.mjs",
          "offline": true
        },
        {
          "name": "prime unit tests",
          "command": "node --test src/agent/advancements.test.mjs src/agent/prime_controller.test.mjs",
          "offline": true
        }
      ],
      "subsystems": []
    },
    {
      "id": "primecraft-runtime",
      "name": "PrimeCraft runtime/tooling",
      "kind": "project",
      "destination": "projects/primecraft-runtime",
      "source_ids": [
        "primecraft-runtime-src"
      ],
      "import_mode": "allowlisted-working-tree-snapshot",
      "diff_labels": [
        "primecraft-runtime"
      ],
      "manifest": "primecraft-runtime-dest.sha256",
      "exclusions": [
        "outputs",
        "work/evidence",
        "work/pads",
        ".prime",
        "worlds",
        "logs",
        "__pycache__",
        "node_modules",
        "everything outside allowlist"
      ],
      "license_files": [],
      "relationships": [
        "orchestrates mindcraft-ce/primecraft-ce and the adapter used by primecraft-vision-loop"
      ],
      "checks": [
        {
          "name": "none offline",
          "command": "true",
          "offline": true
        }
      ],
      "subsystems": []
    },
    {
      "id": "primecraft-vision-loop",
      "name": "PrimeCraft vision loop (QUIC)",
      "kind": "project",
      "destination": "projects/primecraft-vision-loop",
      "source_ids": [
        "quic-vision-loop-src"
      ],
      "import_mode": "allowlisted-working-tree-snapshot",
      "diff_labels": [
        "primecraft-vision-loop"
      ],
      "manifest": "primecraft-vision-loop-dest.sha256",
      "exclusions": [
        "__pycache__",
        "runs",
        "memory stores",
        "skill stores",
        "JSONL state"
      ],
      "license_files": [],
      "relationships": [
        "evolved fuller copy of primecraft-vision-draft",
        "uses adapter in primecraft-runtime"
      ],
      "checks": [
        {
          "name": "compileall",
          "command": "python -m compileall -q primecraft",
          "offline": true
        },
        {
          "name": "smoke_check",
          "command": "python smoke_check.py",
          "offline": true
        },
        {
          "name": "help",
          "command": "python -m primecraft --help",
          "offline": true
        }
      ],
      "subsystems": []
    }
  ]
}